# The Bearer token the app sends with every request.
# Pre-filled as "foobar" so you can deploy and try it straight away.
# Before showing private data, replace it with a long random string and treat it like a password:
# in .dev.vars locally, or in Cloudflare Dashboard -> Worker -> Settings -> Variables and Secrets
# -> Edit secret "WIDGET_TOKEN" (or `npx wrangler secret put WIDGET_TOKEN`).
WIDGET_TOKEN=foobar
