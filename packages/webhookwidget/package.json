{
  "name": "webhookwidget",
  "version": "0.1.1",
  "description": "Types and links for Webhook Widget, which turns any JSON endpoint into an iPhone widget, plus a CLI for setup QR codes and previews",
  "keywords": [
    "webhook widget", "widget", "iphone", "ios", "ios widget", "widgetkit", "home screen", "lock screen",
    "json", "webhook", "dashboard", "qr code", "cloudflare workers", "typescript"
  ],
  "homepage": "https://webhookwidget.com/docs/quickstart/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smoothfrog/webhookwidget.git",
    "directory": "packages/webhookwidget"
  },
  "bugs": "https://github.com/smoothfrog/webhookwidget/issues",
  "license": "MIT",
  "author": "Smooth Frog Ltd <support@webhookwidget.com>",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "webhookwidget": "dist/cli.js"
  },
  "files": ["dist"],
  "engines": {
    "node": ">=18.3"
  },
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && tsc -p test/tsconfig.json && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
